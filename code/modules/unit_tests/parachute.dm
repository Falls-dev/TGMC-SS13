/datum/unit_test/parachute/Run()
	var/mob/living/carbon/human/jumper = allocate(/mob/living/carbon/human)
	var/obj/item/parachute/chute = allocate(/obj/item/parachute)
	var/turf/landing = run_loc_floor_bottom_left
	jumper.forceMove(landing)
	TEST_ASSERT(!chute.deploy(jumper, landing), "A chute on the floor or in hand must not protect a fall")
	TEST_ASSERT(jumper.equip_to_slot_if_possible(chute, SLOT_BACK), "The parachute must equip in the back slot")
	var/before_health = jumper.health
	INVOKE_ASYNC(jumper, TYPE_PROC_REF(/atom/movable, handle_airdrop), landing)
	TEST_ASSERT_EQUAL(chute.descending_wearer, jumper, "The real airdrop entry point must deploy the worn chute")
	TEST_ASSERT(chute.used && chute.canopy in jumper.vis_contents, "The Fulton canopy must appear during descent")
	TEST_ASSERT(HAS_TRAIT(jumper, TRAIT_IMMOBILE), "Descent must prevent ground movement while visually airborne")
	TEST_ASSERT(!jumper.temporarilyRemoveItemFromInventory(chute), "The deployed harness must not be removable during descent")
	sleep(3.2 SECONDS)
	TEST_ASSERT_EQUAL(jumper.health, before_health, "A parachute landing must bypass ordinary fatal airdrop damage")
	TEST_ASSERT_NULL(chute.descending_wearer, "Landing must release the wearer reference")
	TEST_ASSERT_NULL(chute.canopy, "Landing must remove the canopy")
	TEST_ASSERT(!HAS_TRAIT(jumper, TRAIT_IMMOBILE) && !HAS_TRAIT(chute, TRAIT_NODROP), "Landing must remove only the temporary descent restrictions")
	TEST_ASSERT_EQUAL(jumper.pixel_z, 0, "Landing must restore the original visual height")
	TEST_ASSERT(!chute.deploy(jumper, landing), "An unpacked canopy must not protect a second fall")
	TEST_ASSERT(jumper.temporarilyRemoveItemFromInventory(chute), "A landed pack must be removable")
	TEST_ASSERT(jumper.put_in_hands(chute), "The pack must be usable in hand for repacking")
	INVOKE_ASYNC(chute, TYPE_PROC_REF(/obj/item, attack_self), jumper)
	sleep(5.2 SECONDS)
	TEST_ASSERT(!chute.used, "Using the pack in hand must repack it for another jump")
	jumper.temporarilyRemoveItemFromInventory(chute)
	TEST_ASSERT(jumper.equip_to_slot_if_possible(chute, SLOT_BACK), "A repacked chute must equip again")
	// Preserve unrelated immobilization when the parachute is deleted.
	ADD_TRAIT(jumper, TRAIT_IMMOBILE, "parachute-test-other")
	INVOKE_ASYNC(chute, TYPE_PROC_REF(/obj/item/parachute, deploy), jumper, landing)
	var/atom/movable/old_canopy = chute.canopy
	qdel(chute)
	TEST_ASSERT(HAS_TRAIT(jumper, TRAIT_IMMOBILE), "Cleanup must preserve unrelated movement restrictions")
	TEST_ASSERT(!(old_canopy in jumper.vis_contents), "Deletion during descent must remove the canopy")
	TEST_ASSERT_EQUAL(jumper.pixel_z, 0, "Deletion during descent must restore visual height")
	REMOVE_TRAIT(jumper, TRAIT_IMMOBILE, "parachute-test-other")
	var/datum/supply_packs/operations/parachutes/pack = new
	TEST_ASSERT_EQUAL(length(pack.contains), 6, "The supply crate must actually contain six parachutes")
	qdel(pack)
