/datum/unit_test/security_io/Run()
	TEST_ASSERT(is_internet_media_url("https://media.example.invalid/audio.mp3?quality=2&lang=en"), "Accept an absolute HTTPS URL with a query")
	TEST_ASSERT(is_internet_media_url("http://media.example.invalid:8080/track%20one"), "Accept explicit ports and encoded spaces")
	TEST_ASSERT(is_internet_media_url(@"https://[2001:db8::1]/audio.mp3"), "Accept an IPv6 host")
	TEST_ASSERT(!is_internet_media_url("media.example.invalid/audio.mp3"), "Require an absolute HTTP(S) URL")
	TEST_ASSERT(!is_internet_media_url("https:///audio.mp3"), "Require a host")
	TEST_ASSERT(!is_internet_media_url("https://media.example.invalid/track one"), "Require spaces to be encoded")
	TEST_ASSERT(!is_internet_media_url(null), "Reject a missing URL")

	TEST_ASSERT(is_server_log_path("data/logs/"), "Allow the log root")
	TEST_ASSERT(is_server_log_path("data/logs/2026/11/28/round-100/"), "Allow nested round directories")
	TEST_ASSERT(is_server_log_file("data/logs/2026/11/28/round-100/game.log.json"), "Allow standard log files")
	TEST_ASSERT(is_server_log_file("data/logs/round-100/round_end_data.HTML"), "Allow log extensions case-insensitively")
	TEST_ASSERT(!is_server_log_file("data/logs/round-100/"), "Only regular log paths have a log extension")
	TEST_ASSERT(!is_server_log_path("data/archives/round.log"), "Reject paths outside the log root")
	TEST_ASSERT(!is_server_log_path("data/logs/round-100./game.log"), "Reject ambiguous directory names on Windows")
	TEST_ASSERT(!is_server_log_path("data/logs/round-100//game.log"), "Require a canonical separator between components")
